rules_version = '2';

// Правила базы данных сайта «Залипни».
// Публикуются в консоли Firebase: Firestore Database → Правила (Rules) → вставить → Опубликовать.
// Всё, что здесь не разрешено явно, запрещено.

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Админ: UID владельца сайта (его показывает страница /admin). Второго админа — через запятую =====
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['yZ5dDuUehBe67LmN7pqQTJVOR5i1'];
    }

    function signedIn() {
      return request.auth != null;
    }

    // ===== Счётчики: можно только прибавить 1 к одному разрешённому полю =====
    function oldData() {
      return resource == null ? {} : resource.data;
    }
    // Ровно одно поле изменилось, лишних полей нет, ничего не удалено
    function oneFieldOf(keys) {
      return request.resource.data.keys().hasOnly(keys)
        && request.resource.data.diff(oldData()).affectedKeys().size() == 1
        && request.resource.data.diff(oldData()).removedKeys().size() == 0;
    }
    // Поле не изменилось или выросло ровно на 1
    function step(k) {
      return request.resource.data.get(k, 0) == oldData().get(k, 0)
        || request.resource.data.get(k, 0) == oldData().get(k, 0) + 1;
    }

    match /stats/secrets {
      allow read: if isAdmin();
      allow create, update: if oneFieldOf(['logo', 'cheat', 'dot', 'word', 'eyes', 'night', 'lost', 'reader', 'ink', 'explorer'])
        && step('logo') && step('cheat') && step('dot') && step('word') && step('eyes')
        && step('night') && step('lost') && step('reader') && step('ink') && step('explorer');
    }

    match /stats/quiz {
      allow read: if isAdmin();
      allow create, update: if oneFieldOf(['space', 'enter', 'esc', 'caps', 'undo', 'f5'])
        && step('space') && step('enter') && step('esc') && step('caps') && step('undo') && step('f5');
    }

    match /stats/games {
      allow read: if isAdmin();
      allow create, update: if oneFieldOf(['riddle', 'quiz', 'excuse', 'meme', 'reaction', 'emoji'])
        && step('riddle') && step('quiz') && step('excuse') && step('meme') && step('reaction') && step('emoji');
    }

    match /stats/users {
      allow read: if isAdmin();
      allow create, update: if oneFieldOf(['created', 'deleted']) && step('created') && step('deleted');
    }

    match /stats/riddle/days/{day} {
      allow read: if isAdmin();
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && oneFieldOf(['win1', 'win2', 'win3', 'win4', 'lose', 'hint'])
        && step('win1') && step('win2') && step('win3') && step('win4') && step('lose') && step('hint');
    }

    // ===== Прогресс: только сам человек; админ может удалить по просьбе =====
    function optInt(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is int && d[k] >= 0 && d[k] <= max);
    }
    function optList(d, k, max) {
      return !(k in d) || (d[k] is list && d[k].size() <= max);
    }
    function validProgress(d) {
      return d.keys().hasOnly(['secrets', 'tried', 'quiz', 'reactionBest', 'emojiBest',
                               'riddleStreak', 'riddleBest', 'riddleSolved', 'updatedAt'])
        && d.updatedAt == request.time
        && optList(d, 'secrets', 50)
        && optList(d, 'tried', 20)
        && optList(d, 'riddleSolved', 400)
        && (!('quiz' in d) || d.quiz == null || (d.quiz is string && d.quiz.size() <= 20))
        && optInt(d, 'reactionBest', 10000)
        && optInt(d, 'emojiBest', 1000)
        && optInt(d, 'riddleStreak', 10000)
        && optInt(d, 'riddleBest', 10000);
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && validProgress(request.resource.data);
      allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    // ===== Идеи: пишут вошедшие с подтверждённой почтой, читает и удаляет только админ =====
    match /ideas/{id} {
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['text', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3
        && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
        && request.resource.data.done is bool;
    }

    // ===== Расписание загадок: всем — только сегодняшняя и прошлые (без спойлеров), админу — всё =====
    function todayMsk() {
      let t = request.time + duration.value(3, 'h');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }
    function dateNum(s) {
      let p = s.split('-');
      return int(p[0]) * 10000 + int(p[1]) * 100 + int(p[2]);
    }
    function validRiddle(d) {
      return d.keys().hasOnly(['q', 'a', 'h', 'updatedAt'])
        && d.q is string && d.q.size() >= 3 && d.q.size() <= 400
        && d.a is list && d.a.size() >= 1 && d.a.size() <= 10
        && (!('h' in d) || (d.h is string && d.h.size() <= 200));
    }

    match /schedule/{date} {
      allow get: if isAdmin()
        || (date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && dateNum(date) <= todayMsk());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validRiddle(request.resource.data);
      allow delete: if isAdmin();
    }

    // ===== Флаги (включение и выключение секретов): читают все, пишет только админ =====
    match /flags/secrets {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['disabled', 'updatedAt'])
        && request.resource.data.disabled is list
        && request.resource.data.disabled.size() <= 50;
    }
  }
}
